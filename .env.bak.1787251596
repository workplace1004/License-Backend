# Local license server config. Generated setup - fill in DATABASE_URL password.

# PostgreSQL 18 is installed and running on this machine (port 5432).
# Create the DB first:  CREATE DATABASE pos_license;
DATABASE_URL="postgresql://postgres:123@localhost:5432/pos_license?schema=public"

PORT=5050

# AES-256-GCM key for encrypted license files.
# MUST stay identical to VITE_LICENSE_FILE_ENCRYPTION_KEY in frontend/.env.local.
LICENSE_FILE_ENCRYPTION_KEY=8f3a6206c3411627a647669ac58e850d9a77d51ef4f78522d35843296fa3809a

# RSA signing uses ./keys/license-private.pem by default (verified present and matching the public key).

# Change this before any real deployment.
LICENSE_ADMIN_JWT_SECRET=56628de1358c5717ab3a01fa4a86af52b1fc147b5dc0cc25f0788a243ba335ec
